{
  "name": "dohko-ia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build:all": "npm run build && npm run build:web"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/static": "^11.0.0",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "fastify": "^5.12.8",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "stripe": "^23.2.0",
    "unpdf": "^2.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
