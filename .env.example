# Copie para .env e preencha:  cp .env.example .env
NODE_ENV=development
PORT=3000

# Senha do Postgres do docker-compose (troque na VPS!)
POSTGRES_PASSWORD=dohko
# Só para rodar fora do Docker (npm run dev). No Docker, o compose define sozinho.
DATABASE_URL=postgresql://dohko:dohko@localhost:5432/dohko

# Chave que o front/agente da Dohko manda no header x-api-key. Gere com: openssl rand -hex 32
API_KEY=troque-por-uma-chave-com-32-caracteres-ou-mais

# Segredo da sessão de login. Gere com: openssl rand -hex 32
SESSION_SECRET=troque-por-um-segredo-com-64-caracteres-gerado-pelo-openssl-rand

APP_URL=http://localhost:3000

# E-mail transacional (recuperação de senha) via Resend: https://resend.com/api-keys
# Vazio = o link de redefinição aparece no log da API (docker compose logs api | grep redefinir)
RESEND_API_KEY=
MAIL_FROM=Dohko IA <nao-responda@dohkotechnology.com.br>

# E-mails com acesso ao painel de administração (uso, custo e margem), separados por vírgula
ADMIN_EMAILS=

# IA: chave do OpenRouter (https://openrouter.ai/keys) dá acesso a GPT, Claude, Gemini etc.
# Vazia = modo simulado (respostas de exemplo, sem custo) — bom para testar a interface.
OPENROUTER_API_KEY=
# Opcional: trocar os modelos sem mexer no código (ver src/llm/models.ts)
# DOHKO_MODELS=
# DOHKO_TIER_DEFAULT={"fast":"claude-haiku","balanced":"gpt-terra","deep":"claude-sonnet","build":"claude-sonnet"}

# Stripe (modo teste no Mac: chaves sk_test_...)
STRIPE_SECRET_KEY=
# No Mac vem do `stripe listen`; na VPS, do endpoint criado no painel do Stripe
STRIPE_WEBHOOK_SECRET=
# IDs dos preços recorrentes criados no Stripe, por plano
STRIPE_PRICES={"pro_100":"price_xxx","pro_200":"price_xxx","pro_400":"price_xxx","pro_800":"price_xxx"}

USD_TO_BRL=5.5
JOBS_ENABLED=true

# Só na VPS: domínio que aponta para o IP da VPS (ex.: api.dohko.com.br)
DOMAIN=
