# Copie para .env e preencha:  cp .env.example .env
NODE_ENV=development
PORT=3000

# Senha do Postgres do docker-compose (troque na VPS!)
POSTGRES_PASSWORD=dohko
# Só para rodar fora do Docker (npm run dev). No Docker, o compose define sozinho.
DATABASE_URL=postgresql://dohko:dohko@localhost:5432/dohko

# Chave que o front/agente da Dohko manda no header x-api-key. Gere com: openssl rand -hex 32
API_KEY=troque-por-uma-chave-com-32-caracteres-ou-mais

APP_URL=http://localhost:3000

# Stripe (modo teste no Mac: chaves sk_test_...)
STRIPE_SECRET_KEY=
# No Mac vem do `stripe listen`; na VPS, do endpoint criado no painel do Stripe
STRIPE_WEBHOOK_SECRET=
# IDs dos preços recorrentes criados no Stripe, por plano
STRIPE_PRICES={"pro_100":"price_xxx","pro_200":"price_xxx","pro_400":"price_xxx","pro_800":"price_xxx"}

USD_TO_BRL=5.5
JOBS_ENABLED=true

# Só na VPS: domínio que aponta para o IP da VPS (ex.: api.dohko.com.br)
DOMAIN=
